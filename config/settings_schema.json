[
  {
    "name": "theme_info",
    "theme_name": "Agent Issues",
    "theme_version": "0.2.0",
    "theme_author": "Agent Issues Paris",
    "theme_documentation_url": "https://github.com/Agent-Issues-Paris/AGENTISSUES/tree/shopify-theme",
    "theme_support_url": "https://github.com/Agent-Issues-Paris/AGENTISSUES"
  },
  {
    "name": "Issues",
    "settings": [
      {
        "type": "product_list",
        "id": "issue_products",
        "label": "Magazine issues",
        "limit": 20,
        "info": "These products get the issue layout (endless strip of spreads) instead of the regular product page."
      }
    ]
  },
  {
    "name": "Intro",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_intro",
        "label": "Play intro on first visit",
        "default": false,
        "info": "Shown once per browser session; a click skips it."
      },
      {
        "type": "select",
        "id": "intro_mode",
        "label": "Intro type",
        "default": "random",
        "options": [
          {
            "value": "random",
            "label": "Random Agent Issues images"
          },
          {
            "value": "video",
            "label": "Video"
          }
        ]
      },
      {
        "type": "collection",
        "id": "intro_collection",
        "label": "Extra images from collection",
        "info": "Random mode: product photos from this collection join the pool, next to every issue in Theme settings → Issues."
      },
      {
        "type": "range",
        "id": "intro_count",
        "label": "Images per intro",
        "min": 6,
        "max": 40,
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "intro_speed",
        "label": "Time per image",
        "min": 60,
        "max": 600,
        "step": 20,
        "unit": "ms",
        "default": 140
      },
      {
        "type": "video",
        "id": "intro_video",
        "label": "Video",
        "info": "Video mode. Leave empty to use the bundled reel."
      }
    ]
  },
  {
    "name": "Sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "Shown when a non-product page is shared (Instagram, Telegram, iMessage...)."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cookie banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "cookie_banner",
        "label": "Show the site's own cookie banner",
        "default": true,
        "info": "Turn off Shopify's built-in banner in Settings → Customer privacy, otherwise both appear."
      },
      {
        "type": "textarea",
        "id": "cookie_text",
        "label": "Text",
        "default": "We use cookies to understand how the shop is used and to show our ads to the right people."
      },
      {
        "type": "text",
        "id": "cookie_accept_label",
        "label": "Accept button",
        "default": "ACCEPT"
      },
      {
        "type": "text",
        "id": "cookie_decline_label",
        "label": "Decline button",
        "default": "DECLINE"
      }
    ]
  }
]