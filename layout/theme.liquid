<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- endif -%}
<title>
  {%- if template.name == 'index' -%}
    {{ shop.name }}
  {%- else -%}
    {{ page_title }} | {{ shop.name }}
  {%- endif -%}
</title>
{%- if page_description != blank -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
{% render 'meta-tags' %}
{{ 'styles.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {{ 'logo-agent-issues.png' | asset_url | prepend: 'https:' | json }},
      "email": {{ shop.email | json }},
      "sameAs": ["https://www.instagram.com/agent.issues/"]
    }
  </script>
{%- endif -%}
</head>
{%- if request.page_type == 'product' -%}
  {%- capture is_issue -%}{% render 'is-issue', product: product %}{%- endcapture -%}
{%- endif -%}
{%- liquid
  assign body_class = 'template-' | append: template.name | append: ' page-type-' | append: request.page_type
  if is_issue contains 'true'
    assign body_class = body_class | append: ' no-scroll page-issue1'
  elsif template.name == 'product'
    assign body_class = body_class | append: ' page-product'
  endif
-%}
<body class="{{ body_class }}">

{% render 'intro-video' %}

{% section 'header' %}

<main id="MainContent">
  {{ content_for_layout }}
</main>

{% render 'cookie-banner' %}

<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% render 'agentation' %}
</body>
</html>
