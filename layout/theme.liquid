<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- else -%}
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
{%- endif -%}
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
{%- liquid
  # Home keeps its descriptive title; every other tab is "Name / Agent Issues"
  assign page_label = page_title
  case request.page_type
    when 'cart'
      assign page_label = 'Cart'
    when 'collection', 'list-collections'
      assign page_label = 'Shop'
    when 'search'
      assign page_label = 'Search'
    when '404'
      assign page_label = '404'
    when 'product'
      assign page_label = product.title
    when 'page'
      assign page_label = page.title
      if page.handle == 'about'
        assign page_label = 'About Us'
      endif
    when 'policy'
      if request.path contains 'privacy-policy'
        assign page_label = 'Privacy'
      elsif request.path contains 'refund-policy'
        assign page_label = 'Refunds'
      elsif request.path contains 'shipping-policy'
        assign page_label = 'Shipping'
      elsif request.path contains 'terms-of-service'
        assign page_label = 'Terms'
      elsif request.path contains 'contact-information'
        assign page_label = 'Contact'
      endif
  endcase

  assign meta_title = page_label | append: ' / ' | append: shop.name
  assign meta_description = page_description
  if request.page_type == 'index'
    assign meta_title = settings.home_title | default: page_title | default: shop.name
    assign meta_description = settings.home_description | default: page_description
  endif
-%}
<title>{{ meta_title | escape }}</title>
{%- comment -%}
  Safari drops the start of a tab title when it matches the domain
  (agentissues.net), so "Agent Issues / ..." showed without the brand.
  A zero-width space in front of the tab title keeps the brand in the tab.
{%- endcomment -%}
<script>
  if (document.title.indexOf('Agent Issues') === 0) document.title = '\u200B' + document.title;
</script>
{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}
{% render 'meta-tags', title: meta_title, description: meta_description %}
{{ 'styles.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{% render 'structured-data', meta_description: meta_description %}
</head>
{%- if request.page_type == 'product' -%}
  {%- capture is_issue -%}{% render 'is-issue', product: product %}{%- endcapture -%}
{%- endif -%}
{%- liquid
  assign body_class = 'template-' | append: template.name | append: ' page-type-' | append: request.page_type
  if is_issue contains 'true'
    assign body_class = body_class | append: ' no-scroll page-issue1'
  elsif template.name == 'product'
    assign body_class = body_class | append: ' page-product'
  endif
-%}
<body class="{{ body_class }}"{% if settings.clarity_id != blank %} data-clarity-id="{{ settings.clarity_id | escape }}"{% endif %}>

{% render 'intro-video' %}

{% section 'header' %}

<main id="MainContent">
  {{ content_for_layout }}
</main>

{% render 'cookie-banner' %}

<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% render 'agentation' %}
</body>
</html>
