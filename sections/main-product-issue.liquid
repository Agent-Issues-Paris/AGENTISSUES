{%- comment -%}
  Magazine issue page: endless horizontal strip of spreads + buy box.
  Shown for products listed in Theme settings → Issues (or with the "issue"
  template); renders nothing for any other product.
{%- endcomment -%}
{%- capture is_issue -%}{% render 'is-issue', product: product %}{%- endcapture -%}
{%- if is_issue contains 'true' -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  # Texts always come from the product: title, description, and the
  # "Contributors:" paragraph as credits. Issue 1 additionally keeps the
  # flat spreads set up below for its strip; other issues use their photos.
  assign is_legacy = false
  if section.settings.legacy_product != blank and section.settings.legacy_product.id == product.id
    assign is_legacy = true
  endif
-%}
{%- capture blurb_html -%}{% render 'issue-text', html: product.description, part: 'blurb' %}{%- endcapture -%}
{%- capture credits_html -%}{% render 'issue-text', html: product.description, part: 'credits' %}{%- endcapture -%}

{%- capture strip_images -%}
  {%- if is_legacy == false -%}
    {%- for image in product.images -%}
      {%- capture img_class -%}{% if image.aspect_ratio < 1 %}portrait{% endif %}{%- endcapture -%}
      {{ image | image_url: width: 2000 | image_tag: class: img_class, alt: image.alt, data-strip-center: forloop.first, widths: '800, 1400, 2000', sizes: '(max-width: 700px) 100vw, 60vw' }}
    {%- endfor -%}
  {%- elsif section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        {%- capture img_class -%}{% if block.settings.portrait %}portrait{% endif %}{%- endcapture -%}
        {{ block.settings.image | image_url: width: 2000 | image_tag: class: img_class, alt: block.settings.image.alt, data-strip-center: block.settings.center, widths: '800, 1400, 2000', sizes: '(max-width: 700px) 100vw, 60vw' }}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    <img class="portrait" src="{{ 'ISSUE1.png' | asset_url }}" width="912" height="1193" alt="{{ product.title | escape }} cover">
    <img class="portrait" src="{{ 'ISSUE1.2.png' | asset_url }}" width="918" height="1194" alt="{{ product.title | escape }} cover, alternate crop">
    <img src="{{ 'spread-nastya.jpg' | asset_url }}" width="1800" height="1349" alt="">
    <img class="portrait" src="{{ 'spread-nastya-mock.jpg' | asset_url }}" width="1600" height="1828" alt="">
    <img src="{{ 'spread-moods.jpg' | asset_url }}" width="1800" height="1350" alt="">
    <img src="{{ 'spread-mokrov.jpg' | asset_url }}" width="1800" height="1350" alt="Issue spread" data-strip-center="true">
    <img src="{{ 'spread-fake.jpg' | asset_url }}" width="1800" height="1350" alt="">
    <img class="portrait" src="{{ 'spread-raph.jpg' | asset_url }}" width="1600" height="1828" alt="">
  {%- endif -%}
{%- endcapture -%}

<div class="hero-strip">
  <div class="hero-strip__track">
    {{ strip_images }}
    {%- comment -%} Second copy makes the strip loop seamlessly; hidden from screen readers. {%- endcomment -%}
    {{ strip_images | replace: '<img ', '<img aria-hidden="true" ' | replace: 'data-strip-center="true"', '' }}
  </div>
</div>

<section class="columns product-grid">
  <div class="product-col">
    <div class="info-box">
      <h1 class="issue-heading">{{ product.title | escape }}</h1>
      <p>{{ blurb_html }}</p>
    </div>
    <div class="info-box price-box">
      <p data-price-box>{{ current_variant.price | money }}</p>
    </div>
  </div>

  {%- form 'product', product, class: 'product-col product-col--hero', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
    {% render 'qty-cart-controls' %}
    <p class="cart-message" aria-live="polite" data-cart-message>{% unless current_variant.available %}Sold out.{% endunless %}</p>
  {%- endform -%}

  {%- if credits_html != blank -%}
    <div class="product-col credits-col">
      <details class="info-box credits-box">
        <summary>{{ section.settings.credits_label | escape }}</summary>
        <h2 class="credits-box__heading">CONTRIBUTORS</h2>
        {{ credits_html }}
      </details>
    </div>
  {%- endif -%}
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{%- endif -%}

{% schema %}
{
  "name": "Issue",
  "settings": [
    {
      "type": "product",
      "id": "legacy_product",
      "label": "Issue 1 product",
      "info": "Uses the strip images below. Every other issue uses its own product photos. Texts always come from the product: title, description, and a paragraph starting with \"Contributors:\" for the credits."
    },
    {
      "type": "text",
      "id": "credits_label",
      "label": "Credits button label (mobile)",
      "default": "Contributors..."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Strip image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "portrait",
          "label": "Portrait (tall) image",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "center",
          "label": "Start the strip centred on this image",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
