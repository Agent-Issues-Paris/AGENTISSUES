{%- comment -%}
  Magazine issue page: endless horizontal strip of spreads + buy box.
  Shown for products listed in Theme settings → Issues (or with the "issue"
  template); renders nothing for any other product.
{%- endcomment -%}
{%- capture is_issue -%}{% render 'is-issue', product: product %}{%- endcapture -%}
{%- if is_issue contains 'true' -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  # Texts always come from the product: title, description, and the
  # "Contributors:" paragraph as credits. Issue 1 additionally keeps the
  # flat spreads set up below for its strip; other issues use their photos.
  assign is_legacy = false
  if section.settings.legacy_product != blank and section.settings.legacy_product.id == product.id
    assign is_legacy = true
  endif
-%}
{%- capture blurb_html -%}{% render 'issue-text', html: product.description, part: 'blurb' %}{%- endcapture -%}
{%- capture credits_html -%}{% render 'issue-text', html: product.description, part: 'credits' %}{%- endcapture -%}

{%- comment -%}
  Only the first image and the one the strip starts on load right away
  (loading="eager"); the rest are lazy, and theme.js switches them to eager
  once the page has loaded, so they are ready before the strip reaches them.
{%- endcomment -%}
{%- capture strip_images -%}
  {%- if is_legacy == false -%}
    {%- for image in product.images -%}
      {%- capture img_class -%}{% if image.aspect_ratio < 1 %}portrait{% endif %}{%- endcapture -%}
      {%- capture image_alt -%}{{ image.alt | default: product.title }}{% if image.alt == blank %}, photo {{ forloop.index }}{% endif %}{%- endcapture -%}
      {%- liquid
        assign img_loading = 'lazy'
        if forloop.first
          assign img_loading = 'eager'
        endif
      -%}
      {{ image | image_url: width: 2000 | image_tag: class: img_class, alt: image_alt, data-strip-center: forloop.first, loading: img_loading, widths: '800, 1400, 2000', sizes: '(max-width: 700px) 100vw, 60vw' }}
    {%- endfor -%}
  {%- elsif section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        {%- capture img_class -%}{% if block.settings.portrait %}portrait{% endif %}{%- endcapture -%}
        {%- liquid
          assign img_loading = 'lazy'
          if forloop.first or block.settings.center
            assign img_loading = 'eager'
          endif
        -%}
        {{ block.settings.image | image_url: width: 2000 | image_tag: class: img_class, alt: block.settings.image.alt | default: product.title, data-strip-center: block.settings.center, loading: img_loading, widths: '800, 1400, 2000', sizes: '(max-width: 700px) 100vw, 60vw' }}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} Bundled Issue 1 art: WebP, full size plus a half-size copy for phones. {%- endcomment -%}
    <img class="portrait" src="{{ 'issue1-cover.webp' | asset_url }}" srcset="{{ 'issue1-cover-600.webp' | asset_url }} 600w, {{ 'issue1-cover.webp' | asset_url }} 912w" sizes="(max-width: 700px) 100vw, 60vw" width="912" height="1193" loading="eager" alt="Agent Issues Issue 01 'I Heart INSPO' front cover: a man in a patterned shirt walks down a street, photo by Raphaël Lugassy">
    <img class="portrait" src="{{ 'issue1-cover-alt.webp' | asset_url }}" srcset="{{ 'issue1-cover-alt-600.webp' | asset_url }} 600w, {{ 'issue1-cover-alt.webp' | asset_url }} 918w" sizes="(max-width: 700px) 100vw, 60vw" width="918" height="1194" loading="lazy" alt="Agent Issues Issue 01 back cover with a Lewis Dussurget ad">
    <img src="{{ 'spread-nastya.webp' | asset_url }}" srcset="{{ 'spread-nastya-900.webp' | asset_url }} 900w, {{ 'spread-nastya.webp' | asset_url }} 1800w" sizes="(max-width: 700px) 100vw, 60vw" width="1800" height="1349" loading="lazy" alt="Issue 01 spread: photo collage from the Nastya Livadnova story">
    <img class="portrait" src="{{ 'spread-nastya-mock.webp' | asset_url }}" srcset="{{ 'spread-nastya-mock-900.webp' | asset_url }} 900w, {{ 'spread-nastya-mock.webp' | asset_url }} 1600w" sizes="(max-width: 700px) 100vw, 60vw" width="1600" height="1828" loading="lazy" alt="Issue 01 lying open on the Nastya Livadnova story">
    <img src="{{ 'spread-moods.webp' | asset_url }}" srcset="{{ 'spread-moods-900.webp' | asset_url }} 900w, {{ 'spread-moods.webp' | asset_url }} 1800w" sizes="(max-width: 700px) 100vw, 60vw" width="1800" height="1350" loading="lazy" alt="Issue 01 spread: moodboards by stylist Mizuki Hirano and photographer Mery Hoc">
    <img src="{{ 'spread-mokrov.webp' | asset_url }}" srcset="{{ 'spread-mokrov-900.webp' | asset_url }} 900w, {{ 'spread-mokrov.webp' | asset_url }} 1800w" sizes="(max-width: 700px) 100vw, 60vw" width="1800" height="1350" loading="eager" fetchpriority="high" alt="Issue 01 spread from A School for Fools, photography by Roman Mokrov: three women by a green pond, a man floats on a red mattress" data-strip-center="true">
    <img src="{{ 'spread-fake.webp' | asset_url }}" srcset="{{ 'spread-fake-900.webp' | asset_url }} 900w, {{ 'spread-fake.webp' | asset_url }} 1800w" sizes="(max-width: 700px) 100vw, 60vw" width="1800" height="1350" loading="lazy" alt="Issue 01 spread: step-by-step photos of scissors cutting a paper snowflake. Taken from FAKE NATURE story by Onek">
    <img class="portrait" src="{{ 'spread-raph.webp' | asset_url }}" srcset="{{ 'spread-raph-900.webp' | asset_url }} 900w, {{ 'spread-raph.webp' | asset_url }} 1600w" sizes="(max-width: 700px) 100vw, 60vw" width="1600" height="1828" loading="lazy" alt="Issue 01 lying open on the Raphaël Lugassy story">
  {%- endif -%}
{%- endcapture -%}

<div class="hero-strip">
  <div class="hero-strip__track">
    {{ strip_images }}
    {%- comment -%} Second copy makes the strip loop seamlessly; hidden from screen readers. {%- endcomment -%}
    {{ strip_images | replace: '<img ', '<img aria-hidden="true" ' | replace: 'data-strip-center="true"', '' | replace: 'loading="eager"', 'loading="lazy"' | replace: ' fetchpriority="high"', '' }}
  </div>
</div>

<section class="columns product-grid">
  <div class="product-col">
    <div class="info-box">
      <h1 class="issue-heading">{{ product.title | escape }}</h1>
      <p>{{ blurb_html }}</p>
    </div>
    <div class="info-box price-box">
      <p data-price-box>{{ current_variant.price | money }}</p>
    </div>
  </div>

  {%- form 'product', product, class: 'product-col product-col--hero', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
    {%- comment -%} Fixed to the bottom-right corner on desktop, above the buttons on phones {%- endcomment -%}
    {%- liquid
      assign specs_fallback = ''
      if is_legacy
        assign specs_fallback = section.settings.legacy_specs
      endif
    -%}
    {% render 'specs-box', product: product, fallback: specs_fallback %}
    {% render 'qty-cart-controls' %}
    <p class="cart-message" aria-live="polite" data-cart-message>{% unless current_variant.available %}Sold out.{% endunless %}</p>
  {%- endform -%}

  {%- if credits_html != blank -%}
    <div class="product-col credits-col">
      <details class="info-box credits-box">
        <summary>{{ section.settings.credits_label | escape }}</summary>
        <h2 class="credits-box__heading">CONTRIBUTORS</h2>
        {{ credits_html }}
      </details>
    </div>
  {%- endif -%}
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{%- comment -%}
  The same product described as an issue of the magazine, so search
  engines and AI search know it is a periodical. The number comes from the
  handle ("agent-issues-01-...").
{%- endcomment -%}
{%- liquid
  assign issue_number = product.handle | remove_first: 'agent-issues-' | split: '-' | first | plus: 0
  assign blurb_text = blurb_html | replace: '<br>', ' ' | strip_html | strip
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "PublicationIssue",
    "@id": {{ canonical_url | append: '#issue' | json }},
    "name": {{ product.title | json }},
    "url": {{ canonical_url | json }},
    {%- if issue_number > 0 %}
    "issueNumber": {{ issue_number | json }},
    {%- endif %}
    {%- if product.featured_image %}
    "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    {%- if blurb_text != blank %}
    "description": {{ blurb_text | json }},
    {%- endif %}
    "inLanguage": "en",
    "isPartOf": {
      "@type": "Periodical",
      "name": "Agent Issues",
      "url": {{ shop.url | json }},
      "publisher": { "@type": "Organization", "name": "Agent Issues", "url": {{ shop.url | json }} }
    }
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Issue",
  "settings": [
    {
      "type": "product",
      "id": "legacy_product",
      "label": "Issue 1 product",
      "info": "Uses the strip images below. Every other issue uses its own product photos. Texts always come from the product: title, description, and a paragraph starting with \"Contributors:\" for the credits."
    },
    {
      "type": "textarea",
      "id": "legacy_specs",
      "label": "Issue 1 SPECS",
      "info": "Shown while the product's Specs metafield (custom.specs) is empty. One spec per line; \"Label: value\" lines show with a label.",
      "default": "Language: English\nFormat: 23 × 30 cm\nPages: 208\nWeight: 850 g\nPerfect binding\nLimited run"
    },
    {
      "type": "text",
      "id": "credits_label",
      "label": "Credits button label (mobile)",
      "default": "Contributors..."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Strip image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "portrait",
          "label": "Portrait (tall) image",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "center",
          "label": "Start the strip centred on this image",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
