{%- comment -%}
  The hero is the newest product in the chosen collection ("Home page" by
  default), so a new issue takes over as soon as it's added there.
  "Blur the cover" (the Instagram landing, templates/page.instagram.json)
  ships only a 20px copy of the cover, blurred by CSS, with a label on top:
  Instagram's check of the bio link must not find the real cover file on
  the page. The cover still links to the issue page, which shows it whole.
  Texts come from the product (description split at a "Contributors:"
  paragraph into blurb + credits). Issues with flat cover art in assets
  (issueN-cover / issueN-cover-alt, cropped to the magazine so they fill
  the box) use it; any other product uses its Shopify photos.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.frontpage
  assign hero = source.products | sort: 'created_at' | reverse | first
  assign fallback = section.settings.fallback_product
  assign flat = ''
  if hero == blank or fallback != blank and hero.id == fallback.id
    assign flat = 'issue1'
  endif
  if hero == blank
    assign hero = fallback
  endif
  assign flat_w = 912
  if hero.handle contains 'issue-02'
    assign flat = 'issue2'
    assign flat_w = 1824
  endif
  assign variant = hero.selected_or_first_available_variant
-%}

{%- capture blurb_html -%}{% render 'issue-text', html: hero.description, part: 'blurb' %}{%- endcapture -%}
{%- capture credits_html -%}{% render 'issue-text', html: hero.description, part: 'credits' %}{%- endcapture -%}

{%- comment -%} Kept for search engines and screen readers, not shown {%- endcomment -%}
<h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>

{%- if hero != blank -%}
<section class="home-hero">
  <div class="home-hero__info">
    <div class="info-box">
      <h2 class="issue-title">{% render 'product-title', product: hero %}</h2>
      <p>{{ blurb_html }}</p>
    </div>
    {%- if credits_html != blank -%}
      <div class="info-box credits-list">
        <h2>CONTRIBUTORS</h2>
        {{ credits_html }}
      </div>
    {%- endif -%}
  </div>

  {%- assign blur = section.settings.blur_cover -%}
  <a class="home-hero__cover{% if blur %} home-hero__cover--blurred{% endif %}" href="{{ hero.url }}">
    {%- if blur and flat != '' -%}
      <img class="img-default cover-blur" src="{{ flat | append: '-cover-veil.webp' | asset_url }}" width="912" height="1193" alt="{{ hero.title | escape }} cover, blurred">
    {%- elsif blur -%}
      <img class="img-default cover-blur" src="{{ hero.featured_image | image_url: width: 20 }}" width="912" height="1193" alt="{{ hero.title | escape }} cover, blurred">
    {%- elsif flat != '' -%}
      <img class="img-default" src="{{ flat | append: '-cover.webp' | asset_url }}" srcset="{{ flat | append: '-cover-600.webp' | asset_url }} 600w, {{ flat | append: '-cover.webp' | asset_url }} {{ flat_w }}w" sizes="(max-width: 700px) 100vw, 40vw" width="912" height="1193" alt="{{ hero.title | escape }} cover" fetchpriority="high">
      <img class="img-hover" src="{{ flat | append: '-cover-alt.webp' | asset_url }}" srcset="{{ flat | append: '-cover-alt-600.webp' | asset_url }} 600w, {{ flat | append: '-cover-alt.webp' | asset_url }} {{ flat_w }}w" sizes="(max-width: 700px) 100vw, 40vw" width="912" height="1193" alt="" aria-hidden="true" loading="lazy">
    {%- else -%}
      {%- assign img2 = hero.images[1] | default: hero.featured_image -%}
      {{ hero.featured_image | image_url: width: 1600 | image_tag: class: 'img-default', alt: hero.featured_image.alt | default: hero.title, fetchpriority: 'high', widths: '600, 1000, 1600', sizes: '(max-width: 700px) 100vw, 40vw' }}
      {{ img2 | image_url: width: 1600 | image_tag: class: 'img-hover', alt: '', aria-hidden: 'true', loading: 'lazy', widths: '600, 1000, 1600', sizes: '(max-width: 700px) 100vw, 40vw' }}
    {%- endif -%}
    {%- comment -%} The whole cover links to the issue page; the sticker says so. {%- endcomment -%}
    {%- if blur -%}
      <span class="cover-blur-label">{{ section.settings.blur_text | default: 'TAP TO SEE THE COVER' | escape }}</span>
    {%- endif -%}
    <span class="look-inside-sticker">← LOOK INSIDE</span>
  </a>

  {%- form 'product', hero, class: 'home-hero__buy', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" data-variant-input>
    <div class="info-box price-box"><p data-price-box>{{ variant.price | money }}</p></div>
    {% render 'add-box', class: 'home-hero__control' %}
    <div class="info-box home-hero__control info-box--primary"><button type="button" data-checkout>CHECKOUT</button></div>
    <p class="cart-message" aria-live="polite" data-cart-message>{% unless variant.available %}Sold out.{% endunless %}</p>
  {%- endform -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Issue hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading (hidden)",
      "default": "Agent Issues: independent fashion and art print magazine from Paris",
      "info": "Not shown on the page. Search engines and screen readers read it as the main heading of the home page."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The newest product here becomes the hero. Defaults to \"Home page\"."
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Issue 1 product",
      "info": "When this product is the hero it shows the flat cover art. Texts always come from the product."
    },
    {
      "type": "checkbox",
      "id": "blur_cover",
      "label": "Blur the cover",
      "default": false,
      "info": "For the Instagram landing page. The page loads only a tiny blurred copy of the cover; a tap opens the issue page with the full cover."
    },
    {
      "type": "text",
      "id": "blur_text",
      "label": "Text on the blurred cover",
      "default": "TAP TO SEE THE COVER",
      "info": "Keep it neutral: words like \"suggestive\" or \"18+\" on the page can themselves be read as a flag by Instagram's link check."
    }
  ]
}
{% endschema %}
