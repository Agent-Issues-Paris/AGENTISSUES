{%- comment -%}
  The hero is the newest product in the chosen collection ("Home page" by
  default), so a new issue takes over as soon as it's added there.
  Texts come from the product (description split at a "Contributors:"
  paragraph into blurb + credits). Issue 1 keeps its flat cover art;
  any other issue uses its Shopify photos.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.frontpage
  assign hero = source.products | sort: 'created_at' | reverse | first
  assign fallback = section.settings.fallback_product
  assign is_fallback = false
  if hero == blank or fallback != blank and hero.id == fallback.id
    assign is_fallback = true
  endif
  if hero == blank
    assign hero = fallback
  endif
  assign variant = hero.selected_or_first_available_variant
-%}

{%- capture blurb_html -%}{% render 'issue-text', html: hero.description, part: 'blurb' %}{%- endcapture -%}
{%- capture credits_html -%}{% render 'issue-text', html: hero.description, part: 'credits' %}{%- endcapture -%}

{%- if hero != blank -%}
<section class="home-hero">
  <div class="home-hero__info">
    <div class="info-box">
      <h1 class="issue-title">{{ hero.title | escape }}</h1>
      <p>{{ blurb_html }}</p>
    </div>
    {%- if credits_html != blank -%}
      <div class="info-box credits-list">
        <h2>CONTRIBUTORS</h2>
        {{ credits_html }}
      </div>
    {%- endif -%}
  </div>

  <a class="home-hero__cover" href="{{ hero.url }}">
    {%- if is_fallback -%}
      <img class="img-default" src="{{ 'issue1-cover.webp' | asset_url }}" srcset="{{ 'issue1-cover-600.webp' | asset_url }} 600w, {{ 'issue1-cover.webp' | asset_url }} 912w" sizes="(max-width: 700px) 100vw, 40vw" width="912" height="1193" alt="{{ hero.title | escape }} cover" fetchpriority="high">
      <img class="img-hover" src="{{ 'issue1-cover-alt.webp' | asset_url }}" srcset="{{ 'issue1-cover-alt-600.webp' | asset_url }} 600w, {{ 'issue1-cover-alt.webp' | asset_url }} 918w" sizes="(max-width: 700px) 100vw, 40vw" width="918" height="1194" alt="" aria-hidden="true" loading="lazy">
    {%- else -%}
      {%- assign img2 = hero.images[1] | default: hero.featured_image -%}
      {{ hero.featured_image | image_url: width: 1600 | image_tag: class: 'img-default', alt: hero.featured_image.alt | default: hero.title, fetchpriority: 'high', widths: '600, 1000, 1600', sizes: '(max-width: 700px) 100vw, 40vw' }}
      {{ img2 | image_url: width: 1600 | image_tag: class: 'img-hover', alt: '', aria-hidden: 'true', loading: 'lazy', widths: '600, 1000, 1600', sizes: '(max-width: 700px) 100vw, 40vw' }}
    {%- endif -%}
    {%- comment -%} The whole cover links to the issue page; the sticker says so. {%- endcomment -%}
    <span class="look-inside-sticker">← LOOK INSIDE</span>
  </a>

  {%- form 'product', hero, class: 'home-hero__buy', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" data-variant-input>
    <input type="hidden" name="quantity" value="1" data-qty-input>
    <div class="info-box price-box"><p data-price-box>{{ variant.price | money }}</p></div>
    <div class="info-box home-hero__control qty-box">
      <div class="qty">
        <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
        <span data-qty-value>1</span>
        <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
      </div>
    </div>
    <div class="info-box home-hero__control"><button type="submit" data-add-to-cart>ADD TO CART</button></div>
    <div class="info-box home-hero__control info-box--primary"><button type="submit" name="return_to" value="/checkout" data-checkout>CHECKOUT</button></div>
    <p class="cart-message" aria-live="polite" data-cart-message>{% unless variant.available %}Sold out.{% endunless %}</p>
  {%- endform -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Issue hero",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The newest product here becomes the hero. Defaults to \"Home page\"."
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Issue 1 product",
      "info": "When this product is the hero it shows the flat cover art. Texts always come from the product."
    }
  ]
}
{% endschema %}
