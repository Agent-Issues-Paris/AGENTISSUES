{%- liquid
  assign shop_url = routes.collections_url | append: '/shop'
  if section.settings.shop_collection != blank
    assign shop_url = section.settings.shop_collection.url
  endif
  # the ticker follows the home page hero unless a link is set
  assign ticker_url = section.settings.ticker_link
  if ticker_url == blank
    capture ticker_url
      render 'current-issue-url'
    endcapture
  endif

  assign about_url = routes.root_url | append: 'pages/about'
  if section.settings.about_page != blank
    assign about_url = section.settings.about_page.url
  endif

  assign active = ''
  case request.page_type
    when 'index'
      assign active = 'home'
    when 'collection', 'list-collections'
      assign active = 'shop'
    when 'product'
      capture is_issue
        render 'is-issue', product: product
      endcapture
      if is_issue contains 'true'
        assign active = 'home'
      else
        assign active = 'shop'
      endif
    when 'cart'
      assign active = 'cart'
    when 'page'
      if page.url == about_url
        assign active = 'about'
      endif
  endcase
-%}
<header class="site-header">
  <div class="brand-row">
    {%- if section.settings.ticker_text != blank -%}
      {%- capture ticker_line -%}{% for i in (1..10) %}{{ section.settings.ticker_text | escape }} - {% endfor %}{%- endcapture -%}
      {%- if ticker_url != blank -%}
        <a class="ticker" href="{{ ticker_url }}" aria-label="{{ section.settings.ticker_text | escape }}">
      {%- else -%}
        <div class="ticker" role="marquee" aria-label="{{ section.settings.ticker_text | escape }}">
      {%- endif -%}
        <div class="ticker__track" aria-hidden="true">
          <span>{{ ticker_line }}</span>
          <span>{{ ticker_line }}</span>
        </div>
      {%- if ticker_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- else -%}
      <a class="brand-title" href="{{ routes.root_url }}"><span class="brand-title__a">a</span>gent</a>
    {%- endif -%}
    <svg class="star" width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2 L14.59 8.99 L22 9.51 L16.36 14.36 L18.18 21.51 L12 17.5 L5.82 21.51 L7.64 14.36 L2 9.51 L9.41 8.99 Z" stroke="#000" stroke-width="1"/>
    </svg>
  </div>
  <a class="logo-overlay" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {%- comment -%} Plain src, no srcset: "draw ur own logo" swaps the src in theme.js {%- endcomment -%}
      <img src="{{ section.settings.logo | image_url: width: 600 }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" alt="{{ shop.name | escape }} logo">
    {%- else -%}
      <img src="{{ 'logo-agent-issues.webp' | asset_url }}" width="900" height="443" alt="Agent Issues">
    {%- endif -%}
  </a>
  <nav class="main-nav">
    <a href="{{ routes.root_url }}"{% if active == 'home' %} class="active"{% endif %}>Home</a>
    <a href="{{ shop_url }}"{% if active == 'shop' %} class="active"{% endif %}>Shop</a>
    <a href="{{ routes.cart_url }}"{% if active == 'cart' %} class="active"{% endif %} data-cart-count>Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
    <a href="{{ about_url }}"{% if active == 'about' %} class="active"{% endif %}>About</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "info": "Scrolling line at the very top. Leave empty to show the \"agent\" wordmark instead.",
      "default": "PRE ORDER NEW ISSUE “THE FOOD ISSUE” NOW!"
    },
    {
      "type": "url",
      "id": "ticker_link",
      "label": "Ticker link",
      "info": "Leave empty to link to the current issue: the newest product in the Home page collection, the same one the home hero shows."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (shown when scrolling)",
      "info": "Leave empty to use the bundled AGENT ISSUES logo."
    },
    {
      "type": "collection",
      "id": "shop_collection",
      "label": "Shop link",
      "info": "Defaults to the collection with handle \"shop\"."
    },
    {
      "type": "page",
      "id": "about_page",
      "label": "About link",
      "info": "Defaults to /pages/about."
    }
  ]
}
{% endschema %}
