{%- comment -%}
  Grid of product columns from a collection. Used on the home page and
  on collection pages (where it falls back to the current collection).
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank and collection
    assign source = collection
  endif
  if section.settings.all_products
    assign source = collections.all
  endif
  assign products = source.products
  if section.settings.all_products
    assign products = source.products | sort: 'created_at' | reverse
  endif
  assign pinned = section.settings.pinned_product
-%}
<section class="columns">
  {%- if products.size > 0 -%}
    {%- if pinned != blank -%}
      {% render 'product-card', product: pinned, tee: section.settings.tee_framing %}
    {%- endif -%}
    {%- for product in products limit: section.settings.limit -%}
      {%- if pinned != blank and product.id == pinned.id -%}{%- continue -%}{%- endif -%}
      {% render 'product-card', product: product, tee: section.settings.tee_framing %}
    {%- endfor -%}
  {%- else -%}
    <p class="product-loading">No products yet.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product columns",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "On collection pages, leave empty to show that collection."
    },
    {
      "type": "checkbox",
      "id": "all_products",
      "label": "Show every product (newest first)",
      "default": false
    },
    {
      "type": "product",
      "id": "pinned_product",
      "label": "Pin this product first"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Max products",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "tee_framing",
      "label": "T-shirt image framing",
      "default": false
    }
  ],
  "presets": [
    { "name": "Product columns" }
  ]
}
{% endschema %}
