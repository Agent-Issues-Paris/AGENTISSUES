{%- comment -%}
  "Only on page" lets one generic page template carry a page-specific row,
  e.g. the About boxes on /pages/about without assigning a template in admin.
{%- endcomment -%}
{%- liquid
  assign show_row = true
  if section.settings.only_page != blank
    if request.page_type != 'page' or page.handle != section.settings.only_page
      assign show_row = false
    endif
  endif
-%}
{%- if show_row -%}
<section class="info-row{% if section.settings.top %} info-row--top{% endif %}{% if section.blocks.size == 4 %} info-row--4{% endif %}">
  {%- for block in section.blocks -%}
    <div class="info-box info-box--{{ block.type }}" {{ block.shopify_attributes }}>
      <h2>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.heading | escape }}</a>
        {%- else -%}
          {{ block.settings.heading | escape }}
        {%- endif -%}
      </h2>
      {%- case block.type -%}
        {%- when 'policies' -%}
          <ul class="policy-links">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
          {%- if block.settings.text != blank -%}<p class="policy-note">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
        {%- when 'newsletter' -%}
          {%- assign form_id = 'newsletter-' | append: block.id -%}
          {%- form 'customer', class: 'newsletter-form', id: form_id -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p data-newsletter-success>{{ block.settings.success | escape }}</p>
            {%- else -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
              <div class="newsletter-form__row">
                <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ block.settings.placeholder | escape }}" aria-label="Email">
                <button type="submit">{{ block.settings.button | escape }}</button>
              </div>
              {%- if form.errors -%}<div class="newsletter-form__error">{{ form.errors | default_errors }}</div>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- else -%}
          {%- comment -%}
            A line written "Name, City | https://..." turns the box into a
            list of links (stockists); plain text stays a paragraph.
          {%- endcomment -%}
          {%- if block.settings.text contains ' | http' -%}
            {% render 'link-list', text: block.settings.text %}
          {%- else -%}
            <p>{% render 'box-text', text: block.settings.text %}</p>
          {%- endif -%}
      {%- endcase -%}
    </div>
  {%- endfor -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Info boxes",
  "settings": [
    {
      "type": "checkbox",
      "id": "top",
      "label": "Place at top of page",
      "default": false
    },
    {
      "type": "text",
      "id": "only_page",
      "label": "Only on page (handle)",
      "info": "Leave empty to always show. E.g. \"about\" shows this row only on /pages/about."
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "HEADING" },
        { "type": "url", "id": "link", "label": "Heading link" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Text", "info": "Lines written \"Name, City | https://...\" show as a list of links. [words](https://...) makes a link; [words](issue) links to the current issue. @handles link to Instagram." }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "NEWSLETTER: Become a reader with benefits" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Extra stories, field notes and finds from our agents, between issues and after them." },
        { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "YOUR EMAIL" },
        { "type": "text", "id": "button", "label": "Button", "default": "SUBSCRIBE" },
        { "type": "text", "id": "success", "label": "Thank-you text", "default": "Thanks, you are on the list." },
        { "type": "paragraph", "content": "Subscribers appear in Shopify admin → Customers with email marketing consent and the tag \"newsletter\"." }
      ]
    },
    {
      "type": "policies",
      "name": "Policies",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "POLICIES" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text under the links",
          "info": "Links come from Settings → Policies in Shopify admin.",
          "default": "All rights reserved."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Info boxes",
      "blocks": [{ "type": "box" }, { "type": "box" }, { "type": "box" }]
    }
  ]
}
{% endschema %}
