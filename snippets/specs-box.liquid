{%- comment -%}
  SPECS box from the product metafield custom.specs (multi-line text,
  one "Label: value" per line). The shipping note from Theme settings
  goes underneath. Renders nothing when the product has no specs.
  Accepts:
  - product: {Product}
  - collapsible: {Boolean} a <details> that is open on desktop and
    tap-to-expand on phones (issue page)
{%- endcomment -%}
{%- assign specs = product.metafields.custom.specs.value | default: product.metafields.custom.specs -%}
{%- if specs != blank -%}
  {%- capture specs_html -%}
    <dl class="specs-list">
      {%- assign lines = specs | newline_to_br | split: '<br />' -%}
      {%- for raw in lines -%}
        {%- assign line = raw | strip -%}
        {%- if line == blank -%}{%- continue -%}{%- endif -%}
        {%- assign label = line | split: ':' | first | strip -%}
        {%- assign value = line | remove_first: label | remove_first: ':' | strip -%}
        {%- if value == blank -%}
          <div><dd>{{ label | escape }}</dd></div>
        {%- else -%}
          <div><dt>{{ label | escape }}</dt><dd>{{ value | escape }}</dd></div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
    {%- if settings.shipping_note != blank -%}
      <p class="specs-note">{{ settings.shipping_note | escape | newline_to_br }}</p>
    {%- endif -%}
  {%- endcapture -%}

  {%- if collapsible -%}
    <details class="info-box specs-box" data-desktop-open>
      <summary>SPECS</summary>
      <h2 class="specs-box__heading">SPECS</h2>
      {{ specs_html }}
    </details>
  {%- else -%}
    <div class="info-box specs-box">
      <h2>SPECS</h2>
      {{ specs_html }}
    </div>
  {%- endif -%}
{%- endif -%}
