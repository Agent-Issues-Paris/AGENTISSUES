{%- comment -%}
  Everything around the purchase in one box: SPECS (product metafield
  custom.specs), DELIVERY, WHERE TO BUY, CONTACT and POLICIES, each a row
  that opens on tap, one at a time. Texts: Theme settings → Product info box.
  Issue pages pin the box to the bottom-right corner, so it grows upward as
  a row opens; regular product pages end the right-hand column with it.
  On phones the whole box folds into one INFO row.
  Accepts: product {Product}
{%- endcomment -%}
{%- if settings.product_box -%}
  {%- assign specs = product.metafields.custom.specs.value | default: product.metafields.custom.specs -%}
  <details class="info-box product-box" data-product-box data-desktop-open>
    <summary class="product-box__toggle">INFO</summary>
    {%- if specs != blank -%}
      <details class="accordion-item" name="product-box">
        <summary>SPECS</summary>
        <div class="accordion-item__body">{% render 'specs-list', specs: specs %}</div>
      </details>
    {%- endif -%}
    {%- if settings.shipping_note != blank or shop.shipping_policy -%}
      <details class="accordion-item" name="product-box">
        <summary>DELIVERY</summary>
        <div class="accordion-item__body">
          {%- if settings.shipping_note != blank -%}<p>{% render 'box-text', text: settings.shipping_note %}</p>{%- endif -%}
          {%- if shop.shipping_policy -%}
            <ul class="policy-links">
              <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>
              {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>{%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}
    {%- if settings.product_box_stockists != blank -%}
      <details class="accordion-item" name="product-box">
        <summary>WHERE TO BUY</summary>
        <div class="accordion-item__body">{% render 'link-list', text: settings.product_box_stockists %}</div>
      </details>
    {%- endif -%}
    {%- if settings.product_box_contact != blank -%}
      <details class="accordion-item" name="product-box">
        <summary>CONTACT</summary>
        <div class="accordion-item__body"><p>{% render 'box-text', text: settings.product_box_contact %}</p></div>
      </details>
    {%- endif -%}
    {%- if shop.policies.size > 0 -%}
      <details class="accordion-item" name="product-box">
        <summary>POLICIES</summary>
        <div class="accordion-item__body">
          <ul class="policy-links">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      </details>
    {%- endif -%}
  </details>
{%- endif -%}
