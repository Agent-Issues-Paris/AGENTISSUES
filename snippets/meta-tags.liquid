{%- comment -%}
  Open Graph / Twitter tags so shared links show a title and picture.
  Accepts:
  - title {String} the page <title>
  - description {String} the meta description
  The picture is: the product photo on product pages, the collection image
  on collections, else Theme settings → Sharing → share image, else the
  bundled logo card (share-card.png). A product whose cover is hidden
  (is-veiled) never shares its photo: link checkers (Instagram, Facebook)
  get the share image like everyone else.
{%- endcomment -%}
{%- liquid
  assign og_title = title | default: page_title | default: shop.name
  assign og_description = description | default: shop.description | default: shop.name
  assign og_type = 'website'
  assign og_image = settings.share_image
  if request.page_type == 'product'
    assign og_type = 'product'
    capture is_veiled
      render 'is-veiled', product: product
    endcapture
    unless is_veiled contains 'true'
      assign og_image = product.featured_image | default: og_image
    endunless
  elsif request.page_type == 'collection' and collection.image
    assign og_image = collection.image
  endif
  assign og_image_alt = og_image.alt | default: og_title
  if og_image != blank
    assign og_image_url = og_image | image_url: width: 1200 | prepend: 'https:'
  else
    assign og_image_url = 'share-card.png' | asset_url | prepend: 'https:'
    assign og_image_alt = shop.name
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:secure_url" content="{{ og_image_url }}">
{%- if og_image == blank -%}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}
<meta property="og:image:alt" content="{{ og_image_alt | escape }}">
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_image_url }}">
