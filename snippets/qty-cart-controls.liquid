{%- comment -%}
  ADD TO CART (turns into a − N IN CART + stepper once the selected variant
  is in the cart) + CHECKOUT, wired up by theme.js.
  Must sit inside a product form (form 'product').
{%- endcomment -%}
<div class="cart-controls">
  {% render 'add-box' %}
  <div class="info-box info-box--primary"><button type="submit" name="return_to" value="/checkout" data-checkout>CHECKOUT</button></div>
</div>
