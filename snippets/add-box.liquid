{%- comment -%}
  ADD TO CART button that theme.js swaps for a − N IN CART + stepper once
  the selected variant is in the cart (the stepper changes the cart itself).
  Accepts: class {String} extra classes for the box
{%- endcomment -%}
<div class="info-box add-box {{ class }}" data-add-box>
  <button type="submit" class="add-box__add" data-add-to-cart>ADD TO CART</button>
  <div class="qty" data-cart-qty hidden>
    <button type="button" data-qty-minus aria-label="Remove one from cart">−</button>
    <span data-qty-value aria-live="polite"></span>
    <button type="button" data-qty-plus aria-label="Add one more to cart">+</button>
  </div>
</div>
